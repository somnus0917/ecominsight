FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-editable \
    && addgroup --system --gid 10001 ecom \
    && adduser --system --uid 10001 --ingroup ecom ecom \
    && mkdir -p /app/runtime \
    && chown -R ecom:ecom /app

ENV PATH="/app/.venv/bin:${PATH}" \
    ECOM_API_DATABASE_PATH=/app/data/processed/ecom_insight.duckdb \
    ECOM_API_FEEDBACK_DATABASE_PATH=/app/runtime/feedback.sqlite

USER ecom

EXPOSE 8000

CMD ["ecom-api", "--host", "0.0.0.0", "--port", "8000"]
