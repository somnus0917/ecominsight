  "quality_findings": [
    {
      "id": "DQ-001",
      "severity": "critical",
      "finding": "Order exports contain direct personal information, phone and detailed address on all 612 authoritative rows.",
      "risk": "Direct personal information could leak into DuckDB, logs, fixtures, Git, UI or an external model.",
      "required_control": "Streaming sanitization before persistence; delete name/phone/address and HMAC order identifiers with an external salt."
    },
    {
      "id": "DQ-002",
      "severity": "critical",
      "finding": "The snapshot includes authentication tables, browser session state, login images, configuration and logs.",
      "risk": "Credential or session disclosure.",
      "required_control": "Path denylist plus table denylist enforced before discovery; never inspect content."
    },
    {
      "id": "DQ-003",
      "severity": "high",
      "finding": "The four Douyin shops have only 11, 39, 43 and 12 daily observations, with internal gaps.",
      "risk": "A single 56-day calendar range overstates usable per-entity history and invalidates uniform model assumptions.",
      "required_control": "Detector eligibility by entity/metric; preserve missing as unknown until source semantics are confirmed."
    },
    {
      "id": "DQ-004",
      "severity": "high",
      "finding": "Channel, product and search data cover only seven captured dates; one date is missing and shop coverage drops to one row on 2026-07-24.",
      "risk": "STL and per-product machine-learning anomaly detection are unsupported.",
      "required_control": "Use contribution, cross-sectional and rule-based analysis first."
    },
    {
      "id": "DQ-005",
      "severity": "high",
      "finding": "Daily metric payloads have 24 key-set variants and many optional fields.",
      "risk": "Absent, zero and not-applicable values can be conflated.",
      "required_control": "Retain source presence flags and metric provenance in staging."
    },
    {
      "id": "DQ-006",
      "severity": "high",
      "finding": "SQLite amounts are stored in fen and ratios as 0-to-1 fractions, while settlement CSV amounts are yuan decimals.",
      "risk": "Silent 100x money errors or 100x percentage errors.",
      "required_control": "Typed normalization with explicit source_unit, canonical_unit and conversion tests."
    },
    {
      "id": "DQ-007",
      "severity": "medium",
      "finding": "Inventory has 28 negative available quantities, 449 non-positive available quantities, 81 empty spec names and 112 rows where stock != available + lock.",
      "risk": "Naive stockout rules can misclassify backorders or hidden allocations.",
      "required_control": "Confirm WMS semantics and treat negative stock as a separate operational state."
    },
    {
      "id": "DQ-008",
      "severity": "high",
      "finding": "Settlement files contain four summary rows and 6198 business rows at settlement-line grain; order identifiers repeat across lines.",
      "risk": "Counting rows as orders or summing footer rows causes overstatement.",
      "required_control": "Exclude rows without both identifiers and aggregate only after classifying settlement line type."
    },
    {
      "id": "DQ-009",
      "severity": "medium",
      "finding": "Raw daily captures contain 23 duplicate capture rows and two 2026-06-05 shop-date rows not loaded into the main database.",
      "risk": "Direct file ingestion differs from the current main-database view.",
      "required_control": "Use luopan.db as the Phase 2 operations source and preserve a reconciliation test."
    }
  ],
  "differences_from_brief": [
    "The requested absolute source path does not exist in the current environment; an equivalent workspace snapshot was audited.",
    "Product and search datasets are stored in luopan.db payload tables, not as separate first-class files.",
    "There are 55 daily JSON/CSV capture pairs, 130 raw result rows, 107 distinct raw shop-dates and 105 loaded Douyin shop-dates.",
    "External orders have three source labels but four distinct shop IDs.",
    "Settlement has 6202 physical rows, of which 6198 are business rows after excluding one summary row per file.",
    "The current snapshot contains no Excel files.",
    "The latest inventory snapshot duplicates the 2026-07-27 history file and is not a twelfth independent time point.",
    "metrics.db exists but its only table has zero rows."
  ]
