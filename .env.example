# Path to the snapshot's "current" directory. Never commit a real company-data path.
ECOM_SOURCE_ROOT=./luopan-server-snapshot-20260727/current

# Generated outputs are sensitive and ignored by Git.
ECOM_OUTPUT_ROOT=data/processed

# Optional. If omitted, a 0600 local salt is generated under data/.secrets/.
# ECOM_HMAC_SALT=

ECOM_LOG_LEVEL=INFO
ECOM_EXTERNAL_API_ENABLED=false
